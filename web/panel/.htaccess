# Panel de gestión (página fija + app.js): solo scripts de esta web, nada en línea ni de otros dominios
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
