# Seguridad básica
Options -Indexes
ServerSignature Off
<FilesMatch "^(config\.php|config\.sample\.php|.*\.(sqlite3?|db|sql|log|bak|key|pem))$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/(.*/)?(lib|data)/

# Forzar HTTPS (Hostinger da el certificado gratis)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # robots.txt y sitemap.xml para Google
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  # Pasar la cabecera Authorization a PHP
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Siempre (no solo con env=HTTPS: en Hostinger/LiteSpeed esa variable no siempre existe y la cabecera no salía).
  # Los navegadores la ignoran si la página llega por HTTP, así que no molesta en pruebas locales.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(self), geolocation=(), microphone=()"
</IfModule>
